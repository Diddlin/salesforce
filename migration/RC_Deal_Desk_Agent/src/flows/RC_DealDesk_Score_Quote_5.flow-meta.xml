    <decisions>
        <name>Is_Current_Line_MRR</name>
        <label>Is Current Line MRR?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Quote_Line_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_MRR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_Quote_Line_Items.RC_PriceTermUnit__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MRR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_HasMRR_True</targetReference>
            </connector>
            <label>Is MRR</label>
        </rules>
    </decisions>
    <description>Calls LLM to analyze quote, saves comments and JSON to Quote. Input: Quote Id. Output: summary text.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_ExtractHumanSummary</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!varFullRawResponse}, &apos;JSON_PAYLOAD_START&apos;),
    LEFT(
        {!varFullRawResponse},
        FIND(&apos;JSON_PAYLOAD_START&apos;, {!varFullRawResponse}) - 1
    ),
    {!varFullRawResponse}
)</expression>
    </formulas>
    <interviewLabel>RC_DealDesk - Score Quote {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RC_DealDesk - Score Quote</label>
    <loops>
