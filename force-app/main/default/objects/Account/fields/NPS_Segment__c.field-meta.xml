<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NPS_Segment__c</fullName>
    <externalId>false</externalId>
    <label>NPS Segment</label>
    <formula>IF(ISBLANK(NPS__c), "N/A", IF(NPS__c &gt;= 9, "Promoter", IF(NPS__c &gt;= 7, "Passive", "Detractor")))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
    <description>Derived NPS segment (Detractor 0-6, Passive 7-8, Promoter 9-10) that selects which playbook the CTA launches.</description>
</CustomField>
